DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
PORT=5000
NODE_ENV=development

# Local development video storage.
# Uploaded files are written below artifacts/api-server/uploads by default.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads

# Replit/object storage upload/playback flows.
# Replit object storage values are not generally usable from local Windows.
PRIVATE_OBJECT_DIR=/bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/bucket/public
